# Get this from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=your-bot-token-here

# This is the "custom name" -- the bot's server nickname
BOT_NAME=BdayBot

# IANA timezone name, e.g. America/Toronto, America/New_York, Europe/Paris
TIMEZONE=America/Toronto

# 24-hour local time to post reminders each day
REMINDER_HOUR=9

# Optional. Where the SQLite file lives — override this to point at a mounted
# persistent volume (e.g. on Railway: DB_PATH=/data/reminders.db) so data
# survives redeploys.
# DB_PATH=/data/reminders.db

# --- Google Calendar (optional) ---
# The calendar ID to add events to. For your primary calendar this is your
# Gmail address; for a dedicated calendar, find it under that calendar's
# Settings -> "Integrate calendar" -> Calendar ID.
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com

# Option A (local/VPS): path to the service account JSON key file next to
# bot.py. Defaults to service_account.json if not set.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# Option B (Railway, or anywhere you can't drop a file next to bot.py):
# paste the ENTIRE contents of the service_account.json key file here
# instead. If set, this takes priority over GOOGLE_SERVICE_ACCOUNT_FILE.
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "project_id": "...", ...}
